# Copy to .env.local and fill in. .env.local is gitignored.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: never prefix with NEXT_PUBLIC_, never import outside src/server.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the assistant drafting flow (S-01). Server-only.
ANTHROPIC_API_KEY=
# Absolute base URL of this deployment, used to build tenant links (D-03). No trailing slash.
APP_BASE_URL=
# Password for the seeded demo landlord account (C2 seed). Local/demo only.
DEMO_LANDLORD_PASSWORD=
